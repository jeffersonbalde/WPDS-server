APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Minutes until an API login token (Sanctum) is considered expired.
SANCTUM_EXPIRATION=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage for uploaded files (avatars, etc.), so they survive redeploys
# on ephemeral hosting. Leave AWS_ACCESS_KEY_ID blank to use local disk storage
# instead (fine for local development). To use DigitalOcean Spaces, create a
# Space + Spaces Keys and fill these in, e.g.:
#   AWS_DEFAULT_REGION=sgp1
#   AWS_BUCKET=wpds-media
#   AWS_ENDPOINT=https://sgp1.digitaloceanspaces.com
#   AWS_URL=https://wpds-media.sgp1.digitaloceanspaces.com
#   AWS_USE_PATH_STYLE_ENDPOINT=false
#   AWS_ROOT_PATH=          # leave EMPTY — never use a local path like storage/app/public
# Make objects publicly readable (Space File Listing / public-read ACL) so avatars load.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ROOT_PATH=

VITE_APP_NAME="${APP_NAME}"

# Academic-records backups (SQL + JSON)
# BACKUP_PATH=
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_TIME=02:00

# Activity log auto-delete (days). Set 0 to disable.
AUDIT_LOG_RETENTION_DAYS=30
