# Production checklist for West Prime Digital System (WPDS-server).
#
# Copy this to `.env` on the production server and fill in every <PLACEHOLDER>.
# Do NOT reuse the local/dev .env — it has APP_DEBUG=true and a dev APP_KEY.
#
# After filling this in, run in order:
#   1. composer install --no-dev --optimize-autoloader
#   2. php artisan key:generate            (overwrites APP_KEY below — run this AFTER pasting the file)
#   3. php artisan migrate --force
#   4. php artisan db:seed --class=ProductionSeeder --force   (master data + 5 staff accounts, NO fake students)
#   5. php artisan config:cache && php artisan route:cache && php artisan view:cache
#   6. Log in as each staff account (teacher/registrar/admin/it/stakeholder @westprime.edu,
#      password "password") and immediately change the name, email, and password
#      via IT -> User Management.
#
# Do NOT run `migrate:fresh --seed` (the default DatabaseSeeder) against production —
# that also creates 45 fake demo students. It is for local development and for
# showing the UI/UX in demos/meetings only.

APP_NAME="West Prime Digital System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://<your-api-domain>
APP_KEY=                          # generate with `php artisan key:generate`, do not copy the dev key

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error                   # NOT "debug" — debug-level logs are noisy and can include sensitive values

DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database         # no queued jobs in this app today; database driver needs no worker process

# No outgoing email is configured (self-service password reset is intentionally
# disabled — see LoginPage "Forgot password?"). If that changes later, set real
# MAIL_* values here.
MAIL_MAILER=log

# Frontend origin(s) allowed to call this API. Tighten config/cors.php's
# `allowed_origins` from ['*'] to this exact URL before going live.
FRONTEND_URL=https://<your-frontend-domain>
